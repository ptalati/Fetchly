{
  "manifest_version": 3,
  "name": "Fetchly",
  "description": "Send browser downloads to the Fetchly download manager.",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": { "id": "fetchly@fetchly.app", "strict_min_version": "115.0" }
  },
  "permissions": ["downloads", "contextMenus", "nativeMessaging", "cookies", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Fetchly",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
